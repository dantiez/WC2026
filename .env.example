# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Postgres connection string used by the API routes.
# Get one from Neon, Supabase, Vercel Postgres, Railway, etc. Must allow SSL.
# Example: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# Captain (admin) credentials for team-order management.
# Generate password hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
CAPTAIN_EMAIL="captain@example.com"
CAPTAIN_PASSWORD_HASH="$2b$10$replace.with.bcrypt.hash"

# JWT secret for captain sessions. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-32-byte-random-hex"

# Cloudinary unsigned upload (frontend only — these are PUBLIC values).
# Cloud name from Cloudinary dashboard, upload preset must be set to "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
